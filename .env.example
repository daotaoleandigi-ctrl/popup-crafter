# URL cong khai cua Cloudflare Pages app nay
# Vi du: https://popup-crafter.pages.dev hoac https://popup.yourdomain.com
VITE_APP_URL=https://popup-crafter.pages.dev

# LUU Y: Khong can VITE_SUPABASE_URL hay VITE_SUPABASE_PUBLISHABLE_KEY o day.
# Frontend goi qua Cloudflare Function proxy (/api/supabase/*).
# API Key Supabase chi duoc dat trong Cloudflare Pages > Settings > Environment Variables:
#   SUPABASE_URL=https://your-project.supabase.co
#   SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#   GHL_WEBHOOK_SECRET=chuoi-ngau-nhien-dai-dat-trong-ca-cloudflare-va-ghl
